geom_line(data= ELI.c.g, aes(Month, ELI.E, group = L1, colour="Central Pac.\nevent"), linewidth = 0.6, name="Central Pac. event")+
geom_line(data= ELI.e.g, aes(Month, ELI.E, colour = L1), linewidth=2)+
scale_color_manual(values=paleta, name="East Pac. Event")+
scale_x_continuous(labels= rep(month.abb,2), breaks=1:24)+
geom_text(aes(x=12,y=155,label="@duque-gardeazabal"))+
labs(y="ELI [° East]", x="Month since January of year 0 and year 1",
title="ELI evolution in central vs east Pacific El Niño events")+
theme_bw(  )+ theme(legend.key.width = unit(1, "cm"), legend.position = c(0.9,0.9),
axis.title = element_text(size=14, face = "bold"), axis.text = element_text(size=12),
title = element_text(size=16))
