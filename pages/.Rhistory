# load SOI  and ENSO events ----
aux <- read.csv("00A_ELI_SST.csv")
dat <- aux %>%
within(., {
Month <- c(rep(1:12, floor(nrow(aux)/12) ), 1:(nrow(aux) %% 12) )
Year <- X %>% substr(.,1,4) %>% as.numeric()
})
# organize ----
multi.y <- dat %>%
dplyr::summarise(ELI.E.mY = mean(ELI.E),
# SOI.min = min(SOI),
# SOI.max = max(SOI),
# SOI.10 = quantile(SOI, probs=c(0.1)),
# SOI.90 = quantile(SOI, probs=c(0.9)),
.by=c(Month)) %>%
rbind(.,.)
multi.y[13:24,"Month"] <- 13:24
ELI.e <- dat %>%
subset(., Year %in% ENSO.e | Year %in% (ENSO.e+1)) %>%
split(., rep( 1:length(ENSO.e), each=24)) %>%
lapply(., function(x){
y <- subset(x, select= -Year)
y[13:24,"Month"] <- 13:24
return(y)} )
View(ELI.e)
names(ELI.e) <- paste(ENSO.e, ENSO.e+1, sep="-")
ELI.c <- dat %>%
subset(Year %in% ENSO.c | Year %in% (ENSO.c+1)) %>%
split(., rep( 1:length(ENSO.c), each=24)) %>%
lapply(., function(x){
y <- subset(x, select= -Year)
y[13:24,"Month"] <- 13:24
return(y)} )
names(ELI.c) <- paste(ENSO.c, ENSO.c+1, sep="-")
